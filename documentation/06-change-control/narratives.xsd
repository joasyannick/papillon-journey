<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://chrysalide-learning.coop/ns/narratives"
    targetNamespace="http://chrysalide-learning.coop/ns/narratives"
    elementFormDefault="qualified">

  <xs:element name="saga" type="NarrativeType"/>
  <xs:element name="what-if" type="NarrativeType"/>
  <xs:element name="tale" type="NarrativeType"/>
  <xs:element name="epic" type="NarrativeType"/>
  <xs:element name="story" type="StoryType"/>

  <xs:complexType name="StoryType">
    <xs:sequence>
      <xs:element name="responsible-team" type="TeamType"/>
      <xs:element name="priority" type="PriorityType"/>
      <xs:element name="relations" type="StoryRelationsType" minOccurs="0"/>
      <xs:any namespace="http://docbook.org/ns/docbook" processContents="lax"/>
      <xs:element name="activities" type="ActivitiesType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="slug" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ActivitiesType">
    <xs:sequence>
      <xs:element name="elicitation"   type="ActivityRefType" minOccurs="0"/>
      <xs:element name="evaluation"    type="ActivityRefType" minOccurs="0"/>
      <xs:element name="specification" type="ActivityRefType" minOccurs="0"/>
      <xs:element name="development"   type="ActivityRefType" minOccurs="0"/>
      <xs:element name="verification"  type="ActivityRefType" minOccurs="0"/>
      <xs:element name="validation"    type="ActivityRefType" minOccurs="0"/>
      <xs:element name="integration"   type="ActivityRefType" minOccurs="0"/>
      <xs:element name="retrospective" type="ActivityRefType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActivityRefType"/>

  <xs:complexType name="StoryRelationsType">
    <xs:sequence>
      <xs:element name="epic" type="EpicRefType" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EpicRefType">
    <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="slug" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="NarrativeType">
    <xs:sequence>
      <xs:element name="responsible-team" type="TeamType"/>
      <xs:element name="priority" type="PriorityType"/>
      <xs:any namespace="http://docbook.org/ns/docbook" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="slug" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:simpleType name="TeamType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="product"/>
      <xs:enumeration value="project"/>
      <xs:enumeration value="ux"/>
      <xs:enumeration value="art"/>
      <xs:enumeration value="specification"/>
      <xs:enumeration value="development"/>
      <xs:enumeration value="devops"/>
      <xs:enumeration value="verification"/>
      <xs:enumeration value="validation"/>
      <xs:enumeration value="quality"/>
      <xs:enumeration value="security"/>
      <xs:enumeration value="legal"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PriorityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="lowest"/>
      <xs:enumeration value="low"/>
      <xs:enumeration value="medium"/>
      <xs:enumeration value="high"/>
      <xs:enumeration value="highest"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
