<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://chrysalide-learning.coop/ns/narratives/lifecycle"
    targetNamespace="http://chrysalide-learning.coop/ns/narratives/lifecycle"
    elementFormDefault="qualified">

  <xs:element name="elicitation"   type="ActivityType"/>
  <xs:element name="evaluation"    type="ActivityType"/>
  <xs:element name="specification" type="ActivityType"/>
  <xs:element name="development"   type="ActivityType"/>
  <xs:element name="verification"  type="ActivityType"/>
  <xs:element name="validation"    type="ActivityType"/>
  <xs:element name="integration"   type="ActivityType"/>
  <xs:element name="retrospective" type="ActivityType"/>

  <xs:complexType name="ActivityType">
    <xs:sequence>
      <xs:element name="iteration" type="IterationType" minOccurs="1" maxOccurs="unbounded"/>
      <xs:any namespace="http://docbook.org/ns/docbook" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="story-id" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="story-slug" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="IterationType">
    <xs:sequence>
      <xs:element name="time-estimate" type="xs:duration" minOccurs="0"/>
      <xs:element name="start-date" type="xs:date" minOccurs="0"/>
      <xs:element name="target-end" type="xs:date" minOccurs="0"/>
      <xs:element name="actual-end" type="xs:date" minOccurs="0"/>
      <xs:element name="time-spent" type="xs:duration" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

</xs:schema>
