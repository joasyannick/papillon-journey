<glossentry
    xml:id="term-libre-software"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Libre software</glossterm>
  <glossdef>
    <simpara>
      Software that users are free to study, modify, and redistribute, with licensing terms that preserve these freedoms.
    </simpara>
    <glossseealso otherterm="term-limited-exposure">Limited exposure</glossseealso>
  </glossdef>
</glossentry>
