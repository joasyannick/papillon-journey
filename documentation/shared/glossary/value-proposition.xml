  <glossterm>Value proposition</glossterm>
  <glossdef>
    <simpara>
      A clear statement of the benefit a product or service delivers to a specific group of stakeholders.
    </simpara>
    <glossseealso otherterm="term-product-management">Product management</glossseealso>
    <glossseealso otherterm="term-key-success-indicator">Key success indicator</glossseealso>
    <glossseealso otherterm="term-requirement">Requirement</glossseealso>
    <glossseealso otherterm="term-stakeholder">Stakeholder</glossseealso>
  </glossdef>
</glossentry>
