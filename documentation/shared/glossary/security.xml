<glossentry
    xml:id="papj-term-security"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Security</glossterm>
  <glossdef>
    <simpara>
      The practice of protecting systems, data, and users from unauthorised access, misuse, or harm.
    </simpara>
    <glossseealso otherterm="papj-term-quality-assurance">Quality assurance</glossseealso>
  </glossdef>
</glossentry>
