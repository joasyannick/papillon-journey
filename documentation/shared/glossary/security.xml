<glossentry
    xml:id="term-security"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Security</glossterm>
  <glossdef>
    <simpara>
      The integration of secure practices throughout the <glossterm linkend="term-lifecycle-management" baseform="Lifecycle management">product lifecycle</glossterm> to proactively mitigate risks and vulnerabilities.
      As a <glossterm linkend="term-quality-attribute">quality attribute</glossterm>, it expresses the degree to which a system or software protects itself and its data from disruption and unauthorised access, modification, or disclosure.
    </simpara>
    <glossseealso otherterm="term-cross-cutting-concern">Cross-cutting concern</glossseealso>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
  </glossdef>
</glossentry>
