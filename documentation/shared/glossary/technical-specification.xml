<glossentry
    xml:id="term-technical-specification"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Technical specification</glossterm>
  <glossdef>
    <simpara>
      The precise and actionable description of what a system must do and how it is to be structured, bridging the gap between abstract <glossterm linkend="term-requirements-management" baseform="Requirements management">requirements</glossterm> and concrete implementation.
    </simpara>
    <glossseealso otherterm="term-architecture">Architecture</glossseealso>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
    <glossseealso otherterm="term-verification">Verification</glossseealso>
  </glossdef>
</glossentry>
