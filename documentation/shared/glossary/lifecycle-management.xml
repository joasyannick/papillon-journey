    <glossseealso otherterm="term-project-management">Project management</glossseealso>
    <glossseealso otherterm="term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="term-security">Security</glossseealso>
    <glossseealso otherterm="term-software-engineering">Software engineering</glossseealso>
    <glossseealso otherterm="term-systems-engineering">Systems engineering</glossseealso>
  </glossdef>
</glossentry>
