<glossentry
    xml:id="papj-term-lifecycle-management"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Lifecycle management</glossterm>
  <glossdef>
    <simpara>
      The coordinated oversight of all engineering activities across the product lifecycle, from conception through delivery and beyond.
    </simpara>
    <glossseealso otherterm="papj-term-legal-compliance">Legal compliance</glossseealso>
    <glossseealso otherterm="papj-term-product-management">Product management</glossseealso>
    <glossseealso otherterm="papj-term-project-management">Project management</glossseealso>
    <glossseealso otherterm="papj-term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="papj-term-security">Security</glossseealso>
  </glossdef>
</glossentry>
