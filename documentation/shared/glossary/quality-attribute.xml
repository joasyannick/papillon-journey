<glossentry
    xml:id="papj-term-quality-attribute"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Quality attribute</glossterm>
  <glossdef>
    <simpara>
      A property of a system used to judge how well it fulfils non-functional expectations such as performance, security, reliability, or usability.
    </simpara>
    <glossseealso otherterm="papj-term-architecture">Architecture</glossseealso>
  </glossdef>
</glossentry>
