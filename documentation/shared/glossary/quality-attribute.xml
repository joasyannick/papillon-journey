<glossentry
    xml:id="term-quality-attribute"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Quality attribute</glossterm>
  <glossdef>
    <simpara>
      A property of a system or software used to judge how well it fulfils non-functional expectations such as <glossterm linkend="term-reliability">reliability</glossterm>, <glossterm linkend="term-security">security</glossterm>, or <glossterm linkend="term-performance">performance</glossterm>.
    </simpara>
    <glossseealso otherterm="term-architecture">Architecture</glossseealso>
    <glossseealso otherterm="term-interoperability">Interoperability</glossseealso>
    <glossseealso otherterm="term-observability">Observability</glossseealso>
    <glossseealso otherterm="term-performance">Performance</glossseealso>
    <glossseealso otherterm="term-reliability">Reliability</glossseealso>
    <glossseealso otherterm="term-safety">Safety</glossseealso>
    <glossseealso otherterm="term-security">Security</glossseealso>
    <glossseealso otherterm="term-usability">Usability</glossseealso>
  </glossdef>
</glossentry>
