<glossentry
    xml:id="term-quality-attribute"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Quality attribute</glossterm>
  <glossdef>
    <simpara>
      A property of a system used to judge how well it fulfils non-functional expectations such as performance, <glossterm linkend="term-security">security</glossterm>, <glossterm linkend="term-reliability">reliability</glossterm>, or usability.
    </simpara>
    <glossseealso otherterm="term-architecture">Architecture</glossseealso>
    <glossseealso otherterm="term-reliability">Reliability</glossseealso>
    <glossseealso otherterm="term-safety">Safety</glossseealso>
  </glossdef>
</glossentry>
