<glossentry
    xml:id="papj-term-japanese-role-playing-game"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Japanese role-playing game</glossterm>
  <acronym>JRPG</acronym>
  <glossdef>
    <simpara>
      A role-playing game tradition that originated in Japan, in which an overarching narrative shapes the progression of a cast of interdependent characters, and combat systems emphasise strategy over reflex alone.
    </simpara>
    <glossseealso otherterm="papj-term-cross-platform-play">Cross-platform play</glossseealso>
    <glossseealso otherterm="papj-term-downloadable-content">Downloadable content</glossseealso>
    <glossseealso otherterm="papj-term-inverted-pedagogy">Inverted pedagogy</glossseealso>
    <glossseealso otherterm="papj-term-limited-exposure">Limited exposure</glossseealso>
    <glossseealso otherterm="papj-term-mod">Mod</glossseealso>
    <glossseealso otherterm="papj-term-non-player-character">Non-player character</glossseealso>
  </glossdef>
</glossentry>
