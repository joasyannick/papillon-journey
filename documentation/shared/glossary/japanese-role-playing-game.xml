    xml:id="papj-term-jrpg"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Japanese role-playing game</glossterm>
  <acronym>JRPG</acronym>
  <glossdef>
    <simpara>A role-playing game tradition that originated in Japan, in which an overarching narrative shapes the progression of a cast of interdependent characters, and combat systems emphasise strategy over reflex alone.</simpara>
  </glossdef>
