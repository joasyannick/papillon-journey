<glossentry
    xml:id="term-japanese-role-playing-game"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Japanese role-playing game</glossterm>
  <acronym>JRPG</acronym>
  <glossdef>
    <simpara>
      A role-playing game tradition that originated in Japan, in which an overarching narrative shapes the progression of a cast of interdependent characters, and combat systems emphasise strategy over reflex alone.
    </simpara>
    <glossseealso otherterm="term-cross-platform-play">Cross-platform play</glossseealso>
    <glossseealso otherterm="term-crossover">Crossover</glossseealso>
    <glossseealso otherterm="term-downloadable-content">Downloadable content</glossseealso>
    <glossseealso otherterm="term-inverted-pedagogy">Inverted pedagogy</glossseealso>
    <glossseealso otherterm="term-limited-exposure">Limited exposure</glossseealso>
    <glossseealso otherterm="term-mod">Mod</glossseealso>
    <glossseealso otherterm="term-non-player-character">Non-player character</glossseealso>
    <glossseealso otherterm="term-player-versus-player">Player-versus-player</glossseealso>
  </glossdef>
</glossentry>
