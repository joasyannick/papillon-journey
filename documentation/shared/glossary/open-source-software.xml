<glossentry
    xml:id="term-open-source-software"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Open-source software</glossterm>
  <glossdef>
    <simpara>
      Software that users are allowed to study, modify, and redistribute, with licensing terms that may allow derivatives to withhold those permissions from others.
    </simpara>
    <glossseealso otherterm="term-libre-software">Libre software</glossseealso>
    <glossseealso otherterm="term-limited-exposure">Limited exposure</glossseealso>
  </glossdef>
</glossentry>
