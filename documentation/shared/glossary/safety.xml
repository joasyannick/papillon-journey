<glossentry
    xml:id="term-safety"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Safety</glossterm>
  <glossdef>
    <simpara>
      A <glossterm linkend="term-quality-attribute">quality attribute</glossterm> expressing the degree to which a system avoids causing harm to people, property, or the environment under all admissible operating conditions.
    </simpara>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
  </glossdef>
</glossentry>
