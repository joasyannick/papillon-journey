<glossentry
    xml:id="term-user-experience-design"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>User experience design</glossterm>
  <acronym>UX design</acronym>
  <glossdef>
    <simpara>
      The design of intuitive and engaging user experiences that harmonise business goals with user needs, grounding decisions in user research and testing.
    </simpara>
    <glossseealso otherterm="term-art-direction">Art direction</glossseealso>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="term-requirement">Requirement</glossseealso>
    <glossseealso otherterm="term-usability">Usability</glossseealso>
  </glossdef>
</glossentry>
