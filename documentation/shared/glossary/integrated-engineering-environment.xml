<glossentry
    xml:id="term-integrated-engineering-environment"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Integrated engineering environment</glossterm>
  <acronym>IEE</acronym>
  <glossdef>
    <simpara>
      A unified toolchain where <glossterm linkend="term-requirements-management">requirements management</glossterm>, <glossterm linkend="term-user-experience-design" baseform="User experience design">UX design</glossterm>, <glossterm linkend="term-technical-specification" baseform="Technical specification">specification</glossterm>, <glossterm linkend="term-software-development" baseform="Software development">development</glossterm>, <glossterm linkend="term-devops">devops</glossterm>, <glossterm linkend="term-verification">verification</glossterm>, and <glossterm linkend="term-validation">validation</glossterm> activities are integrated — all conducted through one user interface.
    </simpara>
    <glossseealso otherterm="term-devops">Devops</glossseealso>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-fragmented-tooling">Fragmented tooling</glossseealso>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
    <glossseealso otherterm="term-technical-specification">Technical specification</glossseealso>
    <glossseealso otherterm="term-user-experience-design">User experience design</glossseealso>
    <glossseealso otherterm="term-validation">Validation</glossseealso>
    <glossseealso otherterm="term-verification">Verification</glossseealso>
  </glossdef>
</glossentry>
