<glossentry
    xml:id="term-software-engineering"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Software engineering</glossterm>
  <glossdef>
    <simpara>
      The application of engineering principles — rigour, method, and accountability — to the design, construction, and <glossterm linkend="term-maintenance">maintenance</glossterm> of software systems.
    </simpara>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
  </glossdef>
</glossentry>
