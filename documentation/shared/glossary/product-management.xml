<glossentry
    xml:id="term-product-management"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Product management</glossterm>
  <glossdef>
    <simpara>
      The steering and feature prioritisation of a product based on user and market insights, leading it toward the agreed vision.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-project-management">Project management</glossseealso>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-stakeholder">Stakeholder</glossseealso>
    <glossseealso otherterm="term-value-proposition">Value proposition</glossseealso>
  </glossdef>
</glossentry>
