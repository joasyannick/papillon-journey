  <glossterm>Product management</glossterm>
  <glossdef>
    <simpara>The discipline of defining what to build and why, balancing user needs, business goals, and technical constraints.</simpara>
    <glossseealso otherterm="papj-term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="papj-term-project-management">Project management</glossseealso>
    <glossseealso otherterm="papj-term-value-proposition">Value proposition</glossseealso>
    <glossseealso otherterm="papj-term-ux-design">UX design</glossseealso>
  </glossdef>
</glossentry>
