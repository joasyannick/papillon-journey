<glossentry
    xml:id="term-cross-platform-play"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Cross-platform play</glossterm>
  <glossdef>
    <simpara>
      A game experience designed to span multiple device types and operating systems while preserving player progress. In multiplayer modes, it also allows players to connect regardless of platform.
    </simpara>
    <glossseealso otherterm="term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
  </glossdef>
</glossentry>
