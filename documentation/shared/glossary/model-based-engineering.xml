<glossentry
    xml:id="papj-term-model-based-engineering"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Model-based engineering</glossterm>
  <acronym>MBE</acronym>
  <glossdef>
    <simpara>An approach that centres software engineering around explicit models as the primary means of understanding, communicating, and guiding development; some practitioners extend this further by generating implementations and other artefacts directly from those models.</simpara>
    <glossseealso otherterm="papj-term-formal-engineering">Formal engineering</glossseealso>
  </glossdef>
</glossentry>
