<glossentry
    xml:id="term-product-lifecycle"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Product lifecycle</glossterm>
  <glossdef>
    <simpara>
      The sequence of stages through which a product passes, from conception to retirement.
      A product lifecycle can span multiple projects and continues beyond initial delivery through operation, support, and evolution.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
  </glossdef>
</glossentry>
