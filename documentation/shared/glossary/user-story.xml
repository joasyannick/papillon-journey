<glossentry
    xml:id="term-user-story"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>User story</glossterm>
  <glossdef>
    <simpara>
      A <glossterm linkend="term-requirement">requirement</glossterm> told as a story from the user's point of view: who they are, the job they are trying to do, the pains standing in their way, the feature they want, and the gains it unlocks.
    </simpara>
    <glossseealso otherterm="term-requirement">Requirement</glossseealso>
    <glossseealso otherterm="term-stakeholder">Stakeholder</glossseealso>
    <glossseealso otherterm="term-value-proposition">Value proposition</glossseealso>
  </glossdef>
</glossentry>
