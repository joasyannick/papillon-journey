<glossentry
    xml:id="term-verification"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Verification</glossterm>
  <glossdef>
    <simpara>
      The practice of ensuring that a product is being built right — that it meets its <glossterm linkend="term-technical-specification">technical specifications</glossterm> — through testing or <glossterm linkend="term-formal-verification">formal verification</glossterm>.
    </simpara>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-formal-verification">Formal verification</glossseealso>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
    <glossseealso otherterm="term-technical-specification">Technical specification</glossseealso>
  </glossdef>
</glossentry>
