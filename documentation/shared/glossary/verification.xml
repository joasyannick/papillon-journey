<glossentry
    xml:id="papj-term-verification"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Verification</glossterm>
  <glossdef>
    <simpara>
      The process of ensuring that a product is being built right — that it meets its <glossterm linkend="papj-term-technical-specification">technical specifications</glossterm> — through testing or <glossterm linkend="papj-term-formal-verification">formal verification</glossterm>.
    </simpara>
    <glossseealso otherterm="papj-term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="papj-term-formal-verification">Formal verification</glossseealso>
    <glossseealso otherterm="papj-term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="papj-term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="papj-term-software-development">Software development</glossseealso>
    <glossseealso otherterm="papj-term-technical-specification">Technical specification</glossseealso>
  </glossdef>
</glossentry>
