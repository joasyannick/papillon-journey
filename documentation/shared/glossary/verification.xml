  <glossterm>Verification</glossterm>
  <glossdef>
    <simpara>
      The process of evaluating whether a system or component meets its specification — confirming it was built right.
    </simpara>
    <glossseealso otherterm="papj-term-development">Development</glossseealso>
    <glossseealso otherterm="papj-term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="papj-term-specification">Specification</glossseealso>
  </glossdef>
</glossentry>
