<glossentry
    xml:id="term-requirement"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Requirement</glossterm>
  <glossdef>
    <simpara>
      A documented need, constraint, or expectation that a product, system, or software must satisfy to deliver <glossterm linkend="term-value-proposition" baseform="Value proposition">value</glossterm> to users or <glossterm linkend="term-stakeholder">stakeholders</glossterm>.
    </simpara>
    <note>
      <simpara>
        Because users and stakeholders care about functionality and <glossterm linkend="term-value-proposition" baseform="Value proposition">value</glossterm>, requirements should reflect this — leaving design, <glossterm linkend="term-architecture">architecture</glossterm>, and technical choices to <glossterm linkend="term-user-experience-design" baseform="User experience design">UX</glossterm> designers and <glossterm linkend="term-technical-specification" baseform="Technical specification">specification</glossterm> engineers.
        In practice, however, these teams are often handed ‘requirements’ that already embed pre-design or pre-specification decisions.
      </simpara>
    </note>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-stakeholder">Stakeholder</glossseealso>
    <glossseealso otherterm="term-technical-specification">Technical specification</glossseealso>
    <glossseealso otherterm="term-user-experience-design">User experience design</glossseealso>
    <glossseealso otherterm="term-value-proposition">Value proposition</glossseealso>
  </glossdef>
</glossentry>
