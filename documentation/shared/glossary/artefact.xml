<glossentry
    xml:id="term-artefact"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Artefact</glossterm>
  <glossdef>
    <simpara>
      A tangible output produced or consumed during the <glossterm linkend="term-lifecycle-management" baseform="Lifecycle management">product lifecycle</glossterm>, such as a <glossterm linkend="term-technical-specification">technical specification</glossterm>, a model, a formal proof, or an executable.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
  </glossdef>
</glossentry>
