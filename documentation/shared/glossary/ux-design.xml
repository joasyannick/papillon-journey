<glossentry
    xml:id="papj-term-ux-design"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>UX design</glossterm>
  <glossdef>
    <simpara>
      User experience design — the practice of shaping how people interact with a product so that it is useful, usable, and enjoyable.
    </simpara>
    <glossseealso otherterm="papj-term-art-direction">Art direction</glossseealso>
    <glossseealso otherterm="papj-term-requirements-management">Requirements management</glossseealso>
  </glossdef>
</glossentry>
