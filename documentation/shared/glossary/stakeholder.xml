<glossentry
    xml:id="term-stakeholder"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Stakeholder</glossterm>
  <glossdef>
    <simpara>
      Any individual or group with an interest in, or influence over, the outcomes of a project.
    </simpara>
    <glossseealso otherterm="term-product-management">Product management</glossseealso>
    <glossseealso otherterm="term-project-management">Project management</glossseealso>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-value-proposition">Value proposition</glossseealso>
  </glossdef>
</glossentry>
