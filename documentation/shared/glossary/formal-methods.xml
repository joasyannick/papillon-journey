<glossentry
    xml:id="term-formal-methods"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Formal methods</glossterm>
  <glossdef>
    <simpara>
      The modelling of systems and software as mathematical objects, refined stepwise until they are broad enough to capture the <glossterm linkend="term-requirement">requirements</glossterm> of interest and deep enough to support development.
      The term is an umbrella for techniques used to create such models and automate as much of their <glossterm linkend="term-formal-verification" baseform="Formal verification">verification</glossterm> as possible.
    </simpara>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-formal-verification">Formal verification</glossseealso>
  </glossdef>
</glossentry>
