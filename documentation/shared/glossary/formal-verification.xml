<glossentry
    xml:id="term-formal-verification"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Formal verification</glossterm>
  <glossdef>
    <simpara>
      The logical proof that a system or software conforms to its <glossterm linkend="term-technical-specification" baseform="Technical specification">specification</glossterm>, and that the mathematical models defining that specification are consistent with one another across notations, languages, viewpoints, and refinements.
      It establishes correctness of behaviour under all admissible conditions rather than a selection of test cases.
      This proof is a first-class <glossterm linkend="term-artefact">artefact</glossterm>.
    </simpara>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-formal-methods">Formal methods</glossseealso>
    <glossseealso otherterm="term-verification">Verification</glossseealso>
  </glossdef>
</glossentry>
