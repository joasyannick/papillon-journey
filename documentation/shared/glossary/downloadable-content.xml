<glossentry
    xml:id="papj-term-downloadable-content"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Downloadable content</glossterm>
  <acronym>DLC</acronym>
  <glossdef>
    <simpara>
      Official game content distributed electronically after a title’s initial release, typically to add new material rather than modify the base game.
    </simpara>
    <glossseealso otherterm="papj-term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
    <glossseealso otherterm="papj-term-mod">Mod</glossseealso>
  </glossdef>
</glossentry>
