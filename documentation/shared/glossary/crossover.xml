<glossentry
    xml:id="term-crossover"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Crossover</glossterm>
  <glossdef>
    <simpara>
      The inclusion of characters, stories, worlds, or other recognisable elements from one franchise into another.
    </simpara>
    <glossseealso otherterm="term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
  </glossdef>
</glossentry>
