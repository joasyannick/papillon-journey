<glossentry
    xml:id="term-systems-engineering"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Systems engineering</glossterm>
  <glossdef>
    <simpara>
      The application of engineering principles to the definition, design, integration, operation, and evolution of <glossterm linkend="term-system" baseform="System">systems</glossterm> as wholes.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-software-engineering">Software engineering</glossseealso>
    <glossseealso otherterm="term-system">System</glossseealso>
  </glossdef>
</glossentry>
