<glossentry
    xml:id="term-maintenance"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Maintenance</glossterm>
  <glossdef>
    <simpara>
      The upkeep of a software system and its supporting infrastructure after delivery, so that it remains operational and fit for purpose.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
  </glossdef>
</glossentry>
