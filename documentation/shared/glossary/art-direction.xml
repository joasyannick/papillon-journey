<glossentry
    xml:id="papj-term-art-direction"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Art direction</glossterm>
  <glossdef>
    <simpara>
      The definition of a coherent audiovisual style, and its consistent application across all assets created to strengthen the <glossterm linkend="papj-term-user-experience-design" baseform="User experience design">user experience</glossterm>.
    </simpara>
    <glossseealso otherterm="papj-term-user-experience-design">User experience design</glossseealso>
  </glossdef>
</glossentry>
