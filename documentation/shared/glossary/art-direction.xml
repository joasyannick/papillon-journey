<glossentry
    xml:id="papj-term-art-direction"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Art direction</glossterm>
  <glossdef>
    <simpara>
      The discipline of defining and maintaining a coherent visual and audio style across all product assets to strengthen the user experience.
    </simpara>
    <glossseealso otherterm="papj-term-ux-design">UX design</glossseealso>
  </glossdef>
</glossentry>
