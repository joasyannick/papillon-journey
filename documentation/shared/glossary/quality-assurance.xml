  <glossterm>Quality assurance</glossterm>
  <acronym>QA</acronym>
  <glossdef>
    <simpara>
      A systematic approach to ensuring that processes and outputs meet defined standards of quality.
    </simpara>
    <glossseealso otherterm="papj-term-security">Security</glossseealso>
    <glossseealso otherterm="papj-term-validation">Validation</glossseealso>
    <glossseealso otherterm="papj-term-verification">Verification</glossseealso>
  </glossdef>
</glossentry>
