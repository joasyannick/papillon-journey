<glossentry
    xml:id="term-limited-exposure"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Limited exposure</glossterm>
  <glossdef>
    <simpara>
      The restricted presence of formal methods outside high-assurance domains, which perpetuates the misconception that they are irrelevant to mainstream software engineering.
    </simpara>
    <glossseealso otherterm="term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
    <glossseealso otherterm="term-libre-software">Libre software</glossseealso>
    <glossseealso otherterm="term-open-source-software">Open-source software</glossseealso>
  </glossdef>
</glossentry>
