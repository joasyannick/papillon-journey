<glossentry
    xml:id="term-inverted-pedagogy"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Inverted pedagogy</glossterm>
  <glossdef>
    <simpara>
      A teaching approach in which abstract theory precedes practice, often leaving learners with little hands-on experience or only unrealistic examples.
    </simpara>
    <glossseealso otherterm="term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
  </glossdef>
</glossentry>
