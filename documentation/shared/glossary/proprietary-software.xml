<glossentry
    xml:id="term-proprietary-software"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Proprietary software</glossterm>
  <glossdef>
    <simpara>
      Software whose owner restricts users from studying, modifying, or redistributing it.
    </simpara>
    <glossseealso otherterm="term-libre-software">Libre software</glossseealso>
    <glossseealso otherterm="term-open-source-software">Open-source software</glossseealso>
  </glossdef>
</glossentry>
