<glossentry
    xml:id="term-project-management"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Project management</glossterm>
  <glossdef>
    <simpara>
      The shaping and coordination of teams, and the monitoring of risks, to safeguard timely, on-budget delivery that meets <glossterm linkend="term-stakeholder">stakeholder</glossterm> expectations.
    </simpara>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-product-management">Product management</glossseealso>
    <glossseealso otherterm="term-stakeholder">Stakeholder</glossseealso>
  </glossdef>
</glossentry>
