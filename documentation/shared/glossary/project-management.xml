<glossentry
    xml:id="papj-term-project-management"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Project management</glossterm>
  <glossdef>
    <simpara>
      The discipline of planning, executing, and controlling work to deliver outcomes on time and within scope.
    </simpara>
    <glossseealso otherterm="papj-term-product-management">Product management</glossseealso>
    <glossseealso otherterm="papj-term-stakeholder">Stakeholder</glossseealso>
  </glossdef>
</glossentry>
