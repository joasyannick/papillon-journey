<glossentry
    xml:id="term-system"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>System</glossterm>
  <glossdef>
    <simpara>
      A set of interacting elements, possibly including people, processes, <glossterm linkend="term-software">software</glossterm>, hardware, and information, organised to fulfil a purpose within an environment.
    </simpara>
    <glossseealso otherterm="term-architecture">Architecture</glossseealso>
    <glossseealso otherterm="term-software">Software</glossseealso>
    <glossseealso otherterm="term-systems-engineering">Systems engineering</glossseealso>
  </glossdef>
</glossentry>
