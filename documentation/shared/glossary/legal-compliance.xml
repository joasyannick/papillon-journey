  <glossterm>Legal compliance</glossterm>
  <glossdef>
    <simpara>
      The oversight of compliance with applicable laws and regulations throughout the <glossterm linkend="term-lifecycle-management" baseform="Lifecycle management">product lifecycle</glossterm> to safeguard the project and its <glossterm linkend="term-stakeholder">stakeholders</glossterm>.
    </simpara>
    <glossseealso otherterm="term-cross-cutting-concern">Cross-cutting concern</glossseealso>
    <glossseealso otherterm="term-lifecycle-management">Lifecycle management</glossseealso>
    <glossseealso otherterm="term-security">Security</glossseealso>
  </glossdef>
</glossentry>
