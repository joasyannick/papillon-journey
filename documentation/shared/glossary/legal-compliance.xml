<glossentry
    xml:id="papj-term-legal-compliance"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Legal compliance</glossterm>
  <glossdef>
    <simpara>
      The practice of overseeing compliance with applicable laws and regulations to safeguard the project and its stakeholders throughout the product lifecycle.
    </simpara>
    <glossseealso otherterm="papj-term-cross-cutting-concern">Cross-cutting concern</glossseealso>
    <glossseealso otherterm="papj-term-security">Security</glossseealso>
  </glossdef>
</glossentry>
