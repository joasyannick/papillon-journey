<glossentry
    xml:id="papj-term-non-player-character"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Non-player character</glossterm>
  <acronym>NPC</acronym>
  <glossdef>
    <simpara>
      A character in a video game that is not controlled by a player, typically used to populate the game world, advance the narrative, or offer services.
    </simpara>
    <glossseealso otherterm="papj-term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
  </glossdef>
</glossentry>
