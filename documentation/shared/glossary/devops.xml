<glossentry
    xml:id="papj-term-devops"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Devops</glossterm>
  <glossdef>
    <simpara>
      A set of practices that unifies software development and IT operations to continuously build, test, deliver, and operate software through automation and rapid feedback.
    </simpara>
    <glossseealso otherterm="papj-term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="papj-term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="papj-term-observability">Observability</glossseealso>
    <glossseealso otherterm="papj-term-software-development">Software development</glossseealso>
  </glossdef>
</glossentry>
