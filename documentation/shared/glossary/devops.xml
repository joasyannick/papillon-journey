<glossentry
    xml:id="term-devops"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Devops</glossterm>
  <glossdef>
    <simpara>
      The provision and <glossterm linkend="term-maintenance">maintenance</glossterm> of the infrastructure and tooling that enable automated integration, delivery, deployment, and <glossterm linkend="term-observability" baseform="Observability">operational observation</glossterm>.
    </simpara>
    <note>
      <simpara>
        Operational observation closes the feedback loop from deployed systems back to development: runtime failures, performance degradation, and usage patterns reveal what should be fixed, improved, or redesigned next.
      </simpara>
    </note>
    <glossseealso otherterm="term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="term-observability">Observability</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
  </glossdef>
</glossentry>
