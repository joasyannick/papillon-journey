<glossentry
    xml:id="term-architecture"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Architecture</glossterm>
  <glossdef>
    <simpara>
      The structural and organisational design decisions about a system or software that are hardest and most costly to change.
      They aim to achieve key <glossterm linkend="term-quality-attribute">quality attributes</glossterm> and mitigate risks by governing how it fulfils its purpose.
      They determine the responsibilities and boundaries of its components, and the form their interactions take.
    </simpara>
    <glossseealso otherterm="term-cross-cutting-concern">Cross-cutting concern</glossseealso>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
    <glossseealso otherterm="term-technical-specification">Technical specification</glossseealso>
  </glossdef>
</glossentry>
