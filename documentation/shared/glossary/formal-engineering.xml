<glossentry
    xml:id="term-formal-engineering"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Formal engineering</glossterm>
  <glossdef>
    <simpara>
      An approach to systems and software engineering in which <glossterm linkend="term-requirements-management">requirements management</glossterm>, <glossterm linkend="term-user-experience-design" baseform="User experience design">UX design</glossterm>, <glossterm linkend="term-technical-specification" baseform="Technical specification">specification</glossterm>, <glossterm linkend="term-software-development" baseform="Software development">development</glossterm>, <glossterm linkend="term-devops">devops</glossterm>, <glossterm linkend="term-verification">verification</glossterm>, and <glossterm linkend="term-validation">validation</glossterm> activities are <glossterm linkend="term-model-based-engineering" baseform="Model-based engineering">model-based</glossterm> and grounded in <glossterm linkend="term-formal-methods">formal methods</glossterm>.
    </simpara>
    <glossseealso otherterm="term-devops">Devops</glossseealso>
    <glossseealso otherterm="term-formal-methods">Formal methods</glossseealso>
    <glossseealso otherterm="term-formal-verification">Formal verification</glossseealso>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="term-model-based-engineering">Model-based engineering</glossseealso>
    <glossseealso otherterm="term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="term-software-development">Software development</glossseealso>
    <glossseealso otherterm="term-technical-specification">Technical specification</glossseealso>
    <glossseealso otherterm="term-user-experience-design">User experience design</glossseealso>
    <glossseealso otherterm="term-validation">Validation</glossseealso>
    <glossseealso otherterm="term-verification">Verification</glossseealso>
  </glossdef>
</glossentry>
