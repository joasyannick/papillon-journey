    xml:id="term-reliability"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Reliability</glossterm>
  <glossdef>
    <simpara>
      A <glossterm linkend="term-quality-attribute">quality attribute</glossterm> expressing the degree to which a system or software performs its functions correctly and consistently over time in its intended operating environment.
    </simpara>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
  </glossdef>
</glossentry>
