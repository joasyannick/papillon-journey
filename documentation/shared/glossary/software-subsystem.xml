<glossentry
    xml:id="term-software-subsystem"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Software subsystem</glossterm>
  <glossdef>
    <simpara>
      A cohesive part of a larger <glossterm linkend="term-system">system</glossterm> whose behaviour is realised primarily by <glossterm linkend="term-software">software</glossterm> and which can be treated as a system in its own right.
    </simpara>
    <glossseealso otherterm="term-software">Software</glossseealso>
    <glossseealso otherterm="term-system">System</glossseealso>
  </glossdef>
</glossentry>
