<glossentry
    xml:id="term-interoperability"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Interoperability</glossterm>
  <glossdef>
    <simpara>
      The ability of tools, systems, or software components to work together through well-defined interfaces, shared formats, and compatible workflows.
    </simpara>
    <glossseealso otherterm="term-fragmented-tooling">Fragmented tooling</glossseealso>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
  </glossdef>
</glossentry>
