<glossentry
    xml:id="term-fragmented-tooling"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Fragmented tooling</glossterm>
  <glossdef>
    <simpara>
      The lack of integrated, interoperable tool support for formal methods, which obstructs their adoption into everyday engineering workflows.
    </simpara>
    <glossseealso otherterm="term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
  </glossdef>
</glossentry>
