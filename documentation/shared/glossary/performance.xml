<glossentry
    xml:id="term-performance"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Performance</glossterm>
  <glossdef>
    <simpara>
      A <glossterm linkend="term-quality-attribute">quality attribute</glossterm> expressing the degree to which a system or software carries out its functions within acceptable time and resource constraints for its intended operating environment.
    </simpara>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
  </glossdef>
</glossentry>
