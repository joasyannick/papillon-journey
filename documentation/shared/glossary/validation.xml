<glossentry
    xml:id="papj-term-validation"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Validation</glossterm>
  <glossdef>
    <simpara>
      The process of engaging users and <glossterm linkend="papj-term-stakeholder">stakeholders</glossterm> to validate that the right product is being built — that it meets their acceptance criteria and delivers value.
    </simpara>
    <glossseealso otherterm="papj-term-formal-engineering">Formal engineering</glossseealso>
    <glossseealso otherterm="papj-term-integrated-engineering-environment">Integrated engineering environment</glossseealso>
    <glossseealso otherterm="papj-term-quality-assurance">Quality assurance</glossseealso>
    <glossseealso otherterm="papj-term-requirements-management">Requirements management</glossseealso>
    <glossseealso otherterm="papj-term-software-development">Software development</glossseealso>
  </glossdef>
</glossentry>
