<glossentry
    xml:id="term-retention"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Retention</glossterm>
  <glossdef>
    <simpara>
      The degree to which people continue using a product after their first <glossterm linkend="term-user-experience-design" baseform="User experience design">experiences</glossterm> with it.
    </simpara>
    <glossseealso otherterm="term-key-success-indicator">Key success indicator</glossseealso>
  </glossdef>
</glossentry>
