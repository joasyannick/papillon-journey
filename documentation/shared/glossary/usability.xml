<glossentry
    xml:id="term-usability"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Usability</glossterm>
  <glossdef>
    <simpara>
      A <glossterm linkend="term-quality-attribute">quality attribute</glossterm> expressing the degree to which a system or software allows its users to achieve their goals effectively, efficiently, and with satisfaction.
    </simpara>
    <glossseealso otherterm="term-quality-attribute">Quality attribute</glossseealso>
    <glossseealso otherterm="term-user-experience-design">User experience design</glossseealso>
  </glossdef>
</glossentry>
