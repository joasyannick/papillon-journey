<glossentry
    xml:id="term-mod"
    xml:lang="en-GB"
    xmlns="http://docbook.org/ns/docbook"
    version="5.1">
  <glossterm>Mod</glossterm>
  <glossdef>
    <simpara>
      A community-made modification that extends or alters a game’s existing content.
      The creation and sharing of mods is known as modding.
    </simpara>
    <glossseealso otherterm="term-downloadable-content">Downloadable content</glossseealso>
    <glossseealso otherterm="term-japanese-role-playing-game">Japanese role-playing game</glossseealso>
  </glossdef>
</glossentry>
