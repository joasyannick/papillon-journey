<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://chrysalide-learning.coop/ns/contributors/trackers"
    targetNamespace="http://chrysalide-learning.coop/ns/contributors/trackers"
    elementFormDefault="qualified">

  <xs:element name="trackers" type="TrackersType"/>

  <xs:complexType name="TrackersType">
    <xs:sequence>
      <xs:element name="contributor" type="ContributorRefType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ContributorRefType">
    <xs:sequence>
      <xs:element name="github" type="PlatformRefType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="PlatformRefType">
    <xs:attribute name="url" type="xs:anyURI" use="required"/>
  </xs:complexType>

</xs:schema>
