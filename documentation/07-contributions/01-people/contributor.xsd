<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xml="http://www.w3.org/XML/1998/namespace"
    xmlns="http://chrysalide-learning.coop/ns/contributions"
    targetNamespace="http://chrysalide-learning.coop/ns/contributions"
    elementFormDefault="qualified">

  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="http://www.w3.org/2001/xml.xsd"/>

  <xs:element name="contributor" type="ContributorType"/>

  <xs:complexType name="ContributorType">
    <xs:sequence>
      <xs:element name="name" type="NameType"/>
      <xs:element name="account" type="AccountType"/>
      <xs:element name="organisations" type="OrganisationsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute ref="xml:id" use="required"/>
    <xs:attribute ref="xml:lang" use="required" fixed="en-GB"/>
    <xs:attribute name="version" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="\d+\.\d+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="NameType">
    <xs:sequence>
      <xs:element name="given" type="xs:string"/>
      <xs:element name="additional" type="xs:string" minOccurs="0"/>
      <xs:element name="family" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute ref="xml:lang" use="optional"/>
  </xs:complexType>

  <xs:complexType name="AccountType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="platform" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="github"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="OrganisationsType">
    <xs:sequence>
      <xs:element name="organisation" type="OrganisationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="OrganisationType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="position" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>


</xs:schema>
