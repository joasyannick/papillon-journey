<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://chrysalide-learning.coop/ns/contributors"
    targetNamespace="http://chrysalide-learning.coop/ns/contributors"
    elementFormDefault="qualified">

  <xs:import
      namespace="http://www.w3.org/XML/1998/namespace"
      schemaLocation="http://www.w3.org/2001/xml.xsd"/>

  <xs:element name="contributor" type="ContributorType"/>

  <xs:complexType name="ContributorType">
    <xs:sequence>
      <xs:element name="name" type="NameType"/>
      <xs:element name="affiliation" type="AffiliationType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="persona" type="PersonaType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute ref="xml:id" use="required"/>
    <xs:attribute ref="xml:lang" use="required" fixed="en-GB"/>
    <xs:attribute name="version" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="\d+\.\d+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="NameType">
    <xs:sequence>
      <xs:element name="given" type="NamePartType"/>
      <xs:element name="additional" type="NamePartType" minOccurs="0"/>
      <xs:element name="family" type="NamePartType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute ref="xml:lang" use="optional"/>
  </xs:complexType>

  <xs:complexType name="NamePartType" mixed="true">
    <xs:sequence minOccurs="0">
      <xs:element name="translation" type="TranslationType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TranslationType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="from" type="xs:language" use="required"/>
        <xs:attribute name="original" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="PersonaType">
    <xs:sequence>
      <xs:element name="home" type="WebsiteType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="portfolio" type="WebsiteType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="blog" type="WebsiteType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="social" type="SocialType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="tv" type="TvType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="WebsiteType">
    <xs:attribute name="website" type="xs:string" use="required"/>
    <xs:attribute name="url" type="xs:anyURI" use="required"/>
  </xs:complexType>

  <xs:complexType name="SocialType">
    <xs:attribute name="network" type="xs:string" use="required"/>
    <xs:attribute name="url" type="xs:anyURI" use="required"/>
  </xs:complexType>

  <xs:complexType name="TvType">
    <xs:attribute name="channel" type="xs:string" use="required"/>
    <xs:attribute name="url" type="xs:anyURI" use="required"/>
  </xs:complexType>

  <xs:complexType name="AffiliationType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="position" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
