generator client {
    provider = "prisma-client-js"
  }

datasource db {
    provider = "sqlite" // Or PostgreSQL later
    url      = "file:./dev.db"
  }

enum Role {
    owner
    admin
    editor
    viewer
  }

model Assignment {
    id        String  @id @default( uuid() )
    user      User    @relation( fields: [ userId ], references: [ id ] )
    userId    String
    project   Project @relation( fields: [ projectId ], references: [ id ] )
    projectId String
    role      Role

    @@unique( [ userId, projectId ] ) // One role per user per project
  }

model User {
    id        String        @id @default( uuid() )
    email     String        @unique
    password  String
    roles     Assignment[]
  }

model Project {
    id      String        @id @default( uuid() )
    name    String
    public  Boolean       @default( false )
    roles   Assignment[]
  }